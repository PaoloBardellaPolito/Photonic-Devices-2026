# ============================================================
# INTERACTIVE ALL-PASS RING RESONATOR
# For Google Colab
# ============================================================

import numpy as np
import matplotlib.pyplot as plt
import ipywidgets as widgets

from IPython.display import display, clear_output

# Enable widgets in Google Colab
try:
    from google.colab import output
    output.enable_custom_widget_manager()
except ImportError:
    pass


# ============================================================
# CONSTANTS
# ============================================================

c0 = 299792458.0   # speed of light [m/s]


# ============================================================
# RING MODEL
# ============================================================

def update_ring(t, L_um, loss_dB_cm, neff0, ng0,
                lambda0_nm, force_critical):

    # --------------------------------------------------------
    # Units
    # --------------------------------------------------------

    L = L_um * 1e-6
    L_cm = L * 100
    lambda0 = lambda0_nm * 1e-9

    # Equivalent radius, if the ring is circular
    R = L / (2 * np.pi)


    # --------------------------------------------------------
    # Linearized effective-index model
    #
    # ng = neff - lambda * dneff/dlambda
    #
    # therefore at lambda0:
    #
    # dneff/dlambda = (neff0 - ng0)/lambda0
    # --------------------------------------------------------

    dneff_dlambda = (neff0 - ng0) / lambda0


    # --------------------------------------------------------
    # Round-trip propagation loss
    #
    # loss_dB_cm is a POWER attenuation coefficient
    #
    # Power:
    # P(L)/P(0) = 10^(-loss_dB_cm * L_cm / 10)
    #
    # Field:
    # a = 10^(-loss_dB_cm * L_cm / 20)
    # --------------------------------------------------------

    a = 10 ** (-loss_dB_cm * L_cm / 20)


    # --------------------------------------------------------
    # Coupling
    # --------------------------------------------------------

    if force_critical:
        t_used = a
    else:
        t_used = t

    # Cross-coupling amplitude of an ideal lossless coupler
    kappa = np.sqrt(max(0.0, 1 - t_used**2))


    # --------------------------------------------------------
    # Resonance closest to lambda0
    #
    # Resonance condition:
    #
    # beta L = 2 pi m
    #
    # or
    #
    # neff(lambda) L / lambda = m
    # --------------------------------------------------------

    m0 = int(np.round(neff0 * L / lambda0))

    # For the linear neff model the resonance wavelength
    # can be obtained analytically

    lambda_r = (
        L * ng0 /
        (m0 - L * dneff_dlambda)
    )


    # --------------------------------------------------------
    # FSR
    # --------------------------------------------------------

    FSR_f = c0 / (ng0 * L)

    FSR_lambda = lambda_r**2 / (ng0 * L)


    # --------------------------------------------------------
    # Approximate FWHM
    #
    # High-finesse approximation
    # --------------------------------------------------------

    round_trip_factor = t_used * a

    FWHM_lambda = (
        FSR_lambda
        * (1 - round_trip_factor)
        / (np.pi * np.sqrt(round_trip_factor))
    )

    Q = lambda_r / FWHM_lambda

    finesse = FSR_lambda / FWHM_lambda


    # --------------------------------------------------------
    # Spectral window
    #
    # Automatically show several FSRs
    # --------------------------------------------------------

    span = 3.2 * FSR_lambda

    lambda_min = lambda_r - span
    lambda_max = lambda_r + span

    lam = np.linspace(lambda_min, lambda_max, 8000)


    # --------------------------------------------------------
    # Effective index versus wavelength
    # --------------------------------------------------------

    neff = (
        neff0
        + dneff_dlambda * (lam - lambda0)
    )


    # --------------------------------------------------------
    # Propagation constant and round-trip phase
    # --------------------------------------------------------

    beta = 2 * np.pi * neff / lam

    phi = beta * L


    # --------------------------------------------------------
    # Round-trip propagation factor
    # --------------------------------------------------------

    p = a * np.exp(-1j * phi)


    # --------------------------------------------------------
    # All-pass transfer function
    #
    # H = (t - p)/(1 - t p)
    # --------------------------------------------------------

    H = (t_used - p) / (1 - t_used * p)

    T = np.abs(H)**2

    phase_H = np.unwrap(np.angle(H))


    # --------------------------------------------------------
    # Coupling regime
    # --------------------------------------------------------

    tolerance = 1e-4

    if abs(t_used - a) < tolerance:
        regime = "CRITICAL COUPLING"
    elif t_used > a:
        regime = "UNDERCOUPLED"
    else:
        regime = "OVERCOUPLED"


    # --------------------------------------------------------
    # Numerical transmission at resonance
    # --------------------------------------------------------

    H_res = (t_used - a) / (1 - t_used * a)

    T_res = np.abs(H_res)**2


    # --------------------------------------------------------
    # Results
    # --------------------------------------------------------

    clear_output(wait=True)

    print("ALL-PASS RING RESONATOR")
    print("=" * 55)

    print(f"Reference wavelength       : {lambda0_nm:.2f} nm")
    print(f"Round-trip length L        : {L_um:.3f} um")
    print(f"Equivalent radius R        : {R*1e6:.3f} um")

    print()
    print(f"neff(lambda0)              : {neff0:.4f}")
    print(f"ng(lambda0)                : {ng0:.4f}")
    print(f"dneff/dlambda              : {dneff_dlambda:.4e} 1/m")

    print()
    print(f"Propagation loss           : {loss_dB_cm:.3f} dB/cm")
    print(f"Round-trip amplitude a     : {a:.6f}")
    print(f"Self-coupling t            : {t_used:.6f}")
    print(f"Cross-coupling kappa       : {kappa:.6f}")

    print()
    print(f"Coupling regime            : {regime}")

    print()
    print(f"Resonance order m          : {m0}")
    print(f"Nearest resonance          : {lambda_r*1e9:.4f} nm")

    print()
    print(f"FSR                        : {FSR_f/1e9:.3f} GHz")
    print(f"FSR                        : {FSR_lambda*1e9:.4f} nm")

    print()
    print(f"FWHM                       : {FWHM_lambda*1e9:.5f} nm")
    print(f"Finesse                    : {finesse:.2f}")
    print(f"Q                          : {Q:.3e}")

    print()
    print(f"Transmission at resonance  : {T_res:.6f}")

    if force_critical:
        print()
        print("Critical coupling imposed: t = a")


    # ========================================================
    # POWER TRANSMISSION
    # ========================================================

    plt.figure(figsize=(10, 4.5))

    plt.plot(
        lam * 1e9,
        T,
        linewidth=1.6
    )

    plt.axvline(
        lambda_r * 1e9,
        linestyle="--",
        linewidth=1
    )

    plt.xlabel("Wavelength [nm]")
    plt.ylabel("Power transmission")
    plt.title(
        f"All-pass ring — {regime}"
    )

    plt.ylim(0, 1.05)
    plt.grid(True, alpha=0.3)

    plt.show()


    # ========================================================
    # PHASE RESPONSE
    # ========================================================

    plt.figure(figsize=(10, 4.5))

    plt.plot(
        lam * 1e9,
        phase_H,
        linewidth=1.6
    )

    plt.axvline(
        lambda_r * 1e9,
        linestyle="--",
        linewidth=1
    )

    plt.xlabel("Wavelength [nm]")
    plt.ylabel("Phase of H [rad]")
    plt.title("Phase response")

    plt.grid(True, alpha=0.3)

    plt.show()


# ============================================================
# SLIDERS
# ============================================================

slider_layout = widgets.Layout(width="430px")

t_slider = widgets.FloatSlider(
    value=0.98,
    min=0.90,
    max=0.9999,
    step=0.0005,
    description="t",
    readout_format=".4f",
    continuous_update=False,
    layout=slider_layout
)

L_slider = widgets.FloatSlider(
    value=62.8,
    min=20.0,
    max=500.0,
    step=0.1,
    description="L [um]",
    readout_format=".1f",
    continuous_update=False,
    layout=slider_layout
)

loss_slider = widgets.FloatSlider(
    value=28.0,
    min=0.1,
    max=100.0,
    step=0.1,
    description="Loss [dB/cm]",
    readout_format=".1f",
    continuous_update=False,
    layout=slider_layout
)

neff_slider = widgets.FloatSlider(
    value=2.45,
    min=1.5,
    max=3.5,
    step=0.01,
    description="neff",
    readout_format=".2f",
    continuous_update=False,
    layout=slider_layout
)

ng_slider = widgets.FloatSlider(
    value=4.00,
    min=2.0,
    max=5.5,
    step=0.01,
    description="ng",
    readout_format=".2f",
    continuous_update=False,
    layout=slider_layout
)

lambda0_slider = widgets.FloatSlider(
    value=1550.0,
    min=1250.0,
    max=1650.0,
    step=1.0,
    description="lambda0 [nm]",
    readout_format=".0f",
    continuous_update=False,
    layout=slider_layout
)

critical_checkbox = widgets.Checkbox(
    value=False,
    description="Force critical coupling (t = a)",
    indent=False,
    layout=widgets.Layout(width="430px")
)


# ============================================================
# CONNECT WIDGETS TO THE MODEL
# ============================================================

interactive_plot = widgets.interactive_output(
    update_ring,
    {
        "t": t_slider,
        "L_um": L_slider,
        "loss_dB_cm": loss_slider,
        "neff0": neff_slider,
        "ng0": ng_slider,
        "lambda0_nm": lambda0_slider,
        "force_critical": critical_checkbox
    }
)


# ============================================================
# DISPLAY
# ============================================================

controls = widgets.VBox([
    widgets.HTML("<b>Ring parameters</b>"),
    t_slider,
    L_slider,
    loss_slider,
    neff_slider,
    ng_slider,
    lambda0_slider,
    critical_checkbox
])

display(controls, interactive_plot)
